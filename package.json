{
  "name": "qorestamp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QoreStamp — a post-quantum document notary on the QoreChain testnet EVM. Built for the QoreChain Developer Fest (Build Before Q-Day), Quantum Pass.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:testnet": "forge script script/QoreStamp.s.sol --rpc-url qorechain_testnet --broadcast",
    "deployed": "tsx scripts/deployed.ts",
    "attest": "tsx --env-file=.env scripts/attest.ts",
    "proof": "tsx --env-file=.env scripts/proof.ts",
    "stamp": "tsx --env-file=.env scripts/stamp.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "~2.53.1"
  }
}
