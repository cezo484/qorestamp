{"dependencies":{"@cosmjs/stargate":"^0.39.0","@qorechain/evm":"^0.14.0","@qorechain/sdk":"^0.14.0"},"description":"QoreStamp — a post-quantum document notary on the QoreChain testnet EVM. Built for the QoreChain Developer Fest (Build Before Q-Day), Quantum Pass.","devDependencies":{"@types/node":"^22.7.5","tsx":"^4.19.0","typescript":"^5.6.3","viem":"~2.53.1"},"license":"MIT","name":"qorestamp","private":true,"scripts":{"attest":"tsx --env-file=.env scripts/attest.ts","build":"forge build","demo":"node src/demo.js","deploy:testnet":"forge script script/QoreStamp.s.sol --rpc-url qorechain_testnet --broadcast","deployed":"tsx scripts/deployed.ts","forge-std":"forge install foundry-rs/forge-std --no-git","proof":"tsx --env-file=.env scripts/proof.ts","stamp":"tsx --env-file=.env scripts/stamp.ts","start":"node src/cli.js","test":"forge test && node --test test/*.test.js","test:js":"node --test test/*.test.js","typecheck":"tsc --noEmit","web":"node serve.js","window":"tsx --env-file=.env scripts/window.ts"},"type":"module","version":"1.0.0"}